{
  "name": "vivace-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vivace — საკანცელარიო, წიგნების, საჩუქრებისა და სათამაშოების მაღაზია. Static site + Netlify Functions + Netlify Blobs.",
  "scripts": {
