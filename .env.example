# Copy to .env for local runs. On Netlify set these in: Site configuration → Environment variables
# (never commit real values)

# Admin panel password (required)
ADMIN_PASSWORD=change-me-to-a-long-password
# Secret used to sign admin sessions (any long random string)
ADMIN_SECRET=put-a-long-random-string-here

# LIBRA FINANCE ↔ site: the SAME Supabase project that Libra uploads to
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# optional — lets the admin panel show site orders (server-side only)
SUPABASE_SERVICE_KEY=

# optional — new orders to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
